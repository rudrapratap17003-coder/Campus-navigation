# ==============================================================================
# Accessible Campus Navigator - Production & Development Environment Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit a real .env file, private connection strings, or secrets to Git.

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
# Choices: development | testing | production
CAMPUS_ENV=development
CAMPUS_DEBUG=false
CAMPUS_PORT=8501
CAMPUS_ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 2. Production Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# A cryptographically random secret key (minimum 32 characters in production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
CAMPUS_SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-production

# PBKDF2 HMAC-SHA256 Password Cryptography Settings (OWASP 2026 standard)
CAMPUS_SALT_BYTES=32
CAMPUS_HASH_ITERATIONS=600000
CAMPUS_MIN_PASSWORD_LEN=8
CAMPUS_SESSION_HOURS=12
CAMPUS_MAX_LOGIN_ATTEMPTS=5
CAMPUS_LOCKOUT_SECONDS=300
CAMPUS_COOKIE_SECURE=false

# Initial System Administrator Account Bootstrap (Optional for fresh instances)
# If set on first startup, creates this admin if no admin account exists yet
# CAMPUS_ADMIN_USERNAME=admin_bootstrap
# CAMPUS_ADMIN_PASSWORD=ComplexAdminPassword2026!

# ------------------------------------------------------------------------------
# 3. Database Persistence (SQLite / PostgreSQL)
# ------------------------------------------------------------------------------
# SQLite Default Path (Ensure persistent volume mounts /app/database in Docker)
CAMPUS_DB_PATH=database/campus_navigation.db
CAMPUS_DB_TIMEOUT=10.0
CAMPUS_DB_BUSY_TIMEOUT_MS=5000
CAMPUS_DB_JOURNAL_MODE=WAL
CAMPUS_DB_SYNCHRONOUS=NORMAL
CAMPUS_AUTO_BACKUP=true

# PostgreSQL Connection String (Optional: Used when migrating to Cloud SQL / Supabase)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# DATABASE_URL=postgresql://campus_user:your_password@db.example.com:5432/campus_nav?sslmode=require

# ------------------------------------------------------------------------------
# 4. Spatial Map Datasets
# ------------------------------------------------------------------------------
CAMPUS_JAIN_DATA_FILE=data/jain_global_campus.json
CAMPUS_BENCHMARK_DATA_FILE=data/campus_data.json

# ------------------------------------------------------------------------------
# 5. Logging & Operational Observability
# ------------------------------------------------------------------------------
# Choices: DEBUG | INFO | WARNING | ERROR | CRITICAL
CAMPUS_LOG_LEVEL=INFO
CAMPUS_LOG_MAX_BYTES=10485760
CAMPUS_LOG_BACKUP_COUNT=5
CAMPUS_LOG_JSON=false
